// ─────────────────────────────────────────────────────────────────────────────
// SCHEMA 7: FAQPage (use on FAQ / About pages)
// ─────────────────────────────────────────────────────────────────────────────
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "url": "https://www.planningsec.sp.gov.lk/faq/",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Provincial Planning Secretariat – Southern Province?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Provincial Planning Secretariat of the Southern Province is the official government body responsible for coordinating integrated development planning in the Southern Province of Sri Lanka. Located at Dakshinapaya, Labuduwa, Galle, it oversees agriculture, tourism, fisheries, education, health, infrastructure, and environmental affairs."
      }
    },
    {
      "@type": "Question",
      "name": "Where is the Provincial Planning Secretariat located?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Provincial Planning Secretariat is located at Dakshinapaya, Labuduwa, Galle, Southern Province, Sri Lanka (Postal Code: 80000). It is open Monday to Friday from 8:30 AM to 4:30 PM."
      }
    },
    {
      "@type": "Question",
      "name": "How can I contact the Provincial Planning Secretariat?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can contact the Provincial Planning Secretariat by phone at +94-91-XXXXXXX, by email at info@planningsec.sp.gov.lk, or by visiting in person at Dakshinapaya, Labuduwa, Galle during office hours (Monday–Friday, 8:30 AM–4:30 PM)."
      }
    },
    {
      "@type": "Question",
      "name": "What districts does the Southern Province Planning Secretariat cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Provincial Planning Secretariat covers all three districts of the Southern Province: Galle District, Matara District, and Hambantota District."
      }
    },
    {
      "@type": "Question",
      "name": "What services does the Provincial Planning Secretariat provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Secretariat provides provincial development planning, policy coordination, project implementation oversight, public notices, development program information, tender publications, and access to government services across agriculture, tourism, fisheries, industrial development, education, health, and environmental sectors."
      }
    }
  ]
}

